# PAAC environment variables — v7.0.0
# Copy this file to .env and fill in values before running.
# Do NOT commit .env to version control.

# ── Infrastructure ────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Axioms & verification ─────────────────────────────────────────────────────
AXIOM_PATH=config/axioms.yaml
VERIFICATION_TIMEOUT_MS=5000
PAAC_MAX_LOOP_BOUND=10000
PAAC_MAX_INSTRUCTIONS=100000

# ── Security (REQUIRED in production) ────────────────────────────────────────
# API key for X-API-Key header authentication. Leave empty to disable auth.
PAAC_API_KEY=changeme-use-a-strong-random-value

# Ed25519 private key for attestation signing AND PCM certificate signing.
# Both the attestation engine and PCM certificate system share this key.
# Generate with:
#   python3 -c "
#   from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey
#   from cryptography.hazmat.primitives.serialization import Encoding, PrivateFormat, NoEncryption
#   k = Ed25519PrivateKey.generate()
#   print(k.private_bytes(Encoding.PEM, PrivateFormat.PKCS8, NoEncryption()).decode())
#   "
# Paste the full PEM block (including -----BEGIN/END----- lines) as a single line
# with \n escapes, or use a secrets manager / Docker secret.
PAAC_ATTEST_PRIVATE_KEY=

# Corresponding Ed25519 public key (optional — derived from private key if unset).
# Distribute this to third parties for certificate verification.
PAAC_ATTEST_PUBLIC_KEY=

# ── Persistence ───────────────────────────────────────────────────────────────
PAAC_WAL_PATH=checkpoints.wal
PAAC_REGISTRY_PATH=live_registry.json

# ── PCM (Proof-Carrying Modification) ────────────────────────────────────────
# Set to true to require agents to submit proofs with every modification.
PAAC_PCM_MODE=false
PAAC_PCM_LOG=pcm_audit.jsonl

# ── Rate limiting ─────────────────────────────────────────────────────────────
PAAC_RATE_LIMIT=100

# ── Watchdog ──────────────────────────────────────────────────────────────────
PAAC_WATCHDOG_TIMEOUT=60
