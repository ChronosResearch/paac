# PAAC environment variables — v5.0.0
# Copy this file to .env and fill in values before running.
# Do NOT commit .env to version control.

# ── Infrastructure ────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Axioms & verification ─────────────────────────────────────────────────────
AXIOM_PATH=config/axioms.yaml
VERIFICATION_TIMEOUT_MS=5000
PAAC_MAX_LOOP_BOUND=10000
PAAC_MAX_INSTRUCTIONS=100000

# ── Security (REQUIRED in production) ────────────────────────────────────────
# API key for X-API-Key header authentication. Leave empty to disable auth.
PAAC_API_KEY=changeme-use-a-strong-random-value

# HMAC-SHA256 key for PCM certificates (hex-encoded 32 bytes).
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
PAAC_CERT_KEY=changeme-32-byte-hex-key-for-pcm-certificates

# HMAC-SHA256 key for cryptographic attestation (hex-encoded 32 bytes).
PAAC_ATTEST_KEY=changeme-32-byte-hex-key-for-attestation

# ── Persistence ───────────────────────────────────────────────────────────────
PAAC_WAL_PATH=checkpoints.wal
PAAC_REGISTRY_PATH=live_registry.json

# ── PCM (Proof-Carrying Modification) ────────────────────────────────────────
# Set to true to require agents to submit proofs with every modification.
PAAC_PCM_MODE=false
PAAC_PCM_LOG=pcm_audit.jsonl

# ── Rate limiting ─────────────────────────────────────────────────────────────
PAAC_RATE_LIMIT=100

# ── Watchdog ──────────────────────────────────────────────────────────────────
PAAC_WATCHDOG_TIMEOUT=60
