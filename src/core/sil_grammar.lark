// SIL Grammar v2
start: function*

function: "func" IDENT "(" params? ")" "->" type "{" stmt* "}"
params: IDENT ":" type ("," IDENT ":" type)*
type: "int" | "bool" | "string" | "array" "<" type "," NUMBER ">"

?stmt: let_stmt
     | assign_stmt
     | if_stmt
     | while_stmt
     | assert_stmt
     | return_stmt
     | expr_stmt

let_stmt: "let" IDENT ":" type "=" expr ";"
assign_stmt: IDENT "=" expr ";"
if_stmt: "if" "(" expr ")" "{" stmt* "}" ["else" "{" stmt* "}"]
while_stmt: "while" "(" expr ")" "bound" NUMBER "{" stmt* "}"
assert_stmt: "assert" "(" expr ")" ";"
return_stmt: "return" expr ";"
expr_stmt: expr ";"

?expr: logical_or

?logical_or: logical_and ("||" logical_and)*
?logical_and: equality ("&&" equality)*
?equality: relational (("==" | "!=") relational)*
?relational: add (("<" | "<=" | ">" | ">=") add)*
?add: mul (("+" | "-") mul)*
?mul: method_call (("*" | "/") method_call)*

?method_call: atom ("." IDENT "(" [expr ("," expr)*] ")")* | atom ("." "length")*

?atom: NUMBER
     | "true" -> true
     | "false" -> false
     | IDENTIFIER -> var
     | STRING
     | "[" [expr ("," expr)*] "]" -> array_literal
     | "max" "(" expr "," expr ")" -> max_call
     | "min" "(" expr "," expr ")" -> min_call
     | IDENTIFIER "(" [expr ("," expr)*] ")" -> func_call
     | "(" expr ")"

IDENT: /[a-zA-Z_][a-zA-Z0-9_]*/
IDENTIFIER: /[a-zA-Z_][a-zA-Z0-9_]*/

%import common.SIGNED_INT -> NUMBER
%import common.ESCAPED_STRING -> STRING
%import common.WS
%ignore WS
